# Copy to frontend/.env and fill in the publishable key.
# frontend/.env is gitignored. Never commit real values.

# Clerk -> dashboard.clerk.com -> your app -> API Keys -> "Publishable key" (pk_test_...)
# This one is safe to expose in the browser bundle; the secret key is NOT and lives in backend/.env.
VITE_CLERK_PUBLISHABLE_KEY=

VITE_API_BASE_URL=http://localhost:8000
