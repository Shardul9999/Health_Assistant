# Copy to backend/.env and fill in the four secrets below.
# backend/.env is gitignored. Never commit real values.

# --- Local infra (matches docker-compose.yml — no accounts, leave as-is) ---
DATABASE_URL=postgresql+asyncpg://health:localdevpassword@localhost:5432/health_assistant
REDIS_URL=redis://localhost:6379/0

# --- Hosted services (accounts required) ---
# Clerk -> dashboard.clerk.com -> your app -> API Keys -> "Secret keys" (sk_test_...)
CLERK_SECRET_KEY=
# Clerk -> same app -> API Keys -> shows the Frontend API domain.
# JWKS URL is https://<your-frontend-api-domain>/.well-known/jwks.json
# e.g. https://sound-mongoose-42.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# Groq -> console.groq.com/keys (gsk_...)
GROQ_API_KEY=
# Gemini -> aistudio.google.com/apikey (AIza...) — used for embeddings AND LLM fallback
GEMINI_API_KEY=

# --- Tunables (defaults are fine) ---
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_S=60
SIMILARITY_THRESHOLD=0.65
RETRIEVAL_TOP_K=5
ALLOWED_ORIGINS=http://localhost:5173
